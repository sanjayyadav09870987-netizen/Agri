# ==============================================================================
# AgriTradeX Deployment & Environment Variables Configuration Example
# Copy this template to .env or set these in your Vercel Project Settings
# ==============================================================================

# --- Frontend Environment Variables ---
# In unified Vercel deployment, defaults to '/api'.
# If deploying backend separately, set to full URL e.g. https://your-backend.vercel.app/api
VITE_API_BASE_URL=/api

# --- Django Core Settings ---
# Generate a secure secret key for production
SECRET_KEY=your-django-production-secret-key-here
# Set DEBUG to False in production
DEBUG=False
# Comma-separated list of allowed domains
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# --- Production MySQL Database Configuration ---
# Set USE_MYSQL=True to connect to an external production MySQL instance (e.g. PlanetScale, Aiven, TiDB, AWS RDS)
USE_MYSQL=True
DB_NAME=agritradex_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=your_production_mysql_host
DB_PORT=3306

# --- CORS Settings ---
# Comma-separated allowed frontend origins or leave CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:3000,http://localhost:5173
CORS_ALLOW_ALL=True
