# ==============================================================================
# AgriTradeX Django Backend Environment Example
# ==============================================================================

SECRET_KEY=your-django-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# MySQL Database Configuration
USE_MYSQL=True
DB_NAME=agritradex_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=your_production_mysql_host
DB_PORT=3306

CORS_ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:3000,http://localhost:5173
CORS_ALLOW_ALL=True
